{
  "limits": {
    "recv_buffer_size": 16384,
    "send_buffer_size": 16384,
    "max_body": 16777216,
    "max_line_bytes": 8192,
    "max_headers": 32,
    "max_chunked_body": 65536,
    "static_cache_entries": 16,
    "static_cache_valid_seconds": 1,
    "static_content_cache_max": 16384,
    "connection_pool_max": 1024
  },
  "routes": [
    {
      "path": "/echo",
      "match": "exact",
      "modules": { "content": "echo" }
    },
    {
      "path": "/gzip",
      "match": "prefix",
      "max_age": 3600,
      "modules": {
        "content": "echo",
        "preaccess": "conditional_get",
        "post_access": "cache_headers",
        "log": "gzip"
      }
    },
    {
      "path": "/static",
      "match": "prefix",
      "modules": { "content": "static" },
      "root": "testdata",
      "index": "index.html",
      "autoindex": true
    },
    {
      "path": "/health",
      "match": "exact",
      "response": { "status": 200, "body": "ok" }
    },
    {
      "path": "/old",
      "match": "exact",
      "response": { "status": 301, "headers": [{ "name": "Location", "value": "/health" }] }
    },
    {
      "path": "/",
      "match": "prefix",
      "modules": { "content": "echo" }
    },
    {
      "path": "/chunked",
      "match": "exact",
      "chunked": true,
      "modules": { "content": "echo" }
    }
  ]
}
