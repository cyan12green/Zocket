# nginx counterpart for the modules benchmark (same five endpoints).
worker_processes 4;
daemon off;
error_log @@ERRLOG@@ crit;
pid @@PREFIX@@/nginx.pid;

events {
    worker_connections 16384;
}

http {
    access_log off;
    server_tokens off;
    keepalive_timeout 65;
    keepalive_requests 100000;
    sendfile on;
    sendfile_max_chunk 1m;

    # cache_hit cell: proxy_cache in front of an origin echo endpoint
    proxy_cache_path @@CACHEDIR@@ levels=1:2 keys_zone=modules:16m max_size=64m inactive=600s;

    upstream origin {
        server 127.0.0.1:@@ORIGIN@@;
        keepalive 64;
    }

    limit_req_zone $binary_remote_addr zone=lim:16m rate=1000000r/s;

    server {
        listen 127.0.0.1:@@PORT@@;

        location = /h {
            add_header X-A "1" always;
            add_header X-B $remote_addr always;
            echo -n "";
        }

        location = /auth {
            auth_basic "bench";
            auth_basic_user_file @@HTPASSWD@@;
            echo -n "";
        }

        location / {
            gzip_static on;
            root @@STATICDIR@@;
        }

        location = /cached {
            proxy_pass http://origin;
            proxy_cache modules;
            proxy_cache_valid 200 3600s;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        location = /proxied {
            proxy_pass http://origin;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        location = /limited {
            limit_req zone=lim burst=10000 nodelay;
            echo -n "";
        }

        # ret cell: fixed response (this nginx build has no rewrite module,
        # so the echo module generates the body; Zocket uses `return`)
        location = /ret {
            echo -n "ok";
        }

        # named cell: try_files miss -> named location
        location = /named {
            root @@STATICDIR@@;
            try_files $uri @app;
        }
        location @app {
            echo -n "fallback";
        }

        # accel cell: upstream X-Accel-Redirect -> internal file
        location /int/ {
            internal;
            alias @@STATICDIR@@/;
        }
        location = /accel {
            proxy_pass http://origin/accel;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        # sub_filter cell
        location = /subf {
            proxy_pass http://origin/static/sub.txt;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            sub_filter "ORIGIN" "ZOCKET";
            sub_filter_once off;
            sub_filter_types text/plain;
        }

        # gzip cell: proxy an 8 KB body, compress it on the way out
        location = /gz {
            proxy_pass http://origin/static/sub.txt;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            default_type text/plain;
            gzip on;
            gzip_types text/plain;
        }

        # proxy_hide_header cell
        location = /hide {
            proxy_pass http://origin/hide;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_hide_header X-Powered-By;
        }
    }
}
