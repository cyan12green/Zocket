.{
    // Package name used by dependents (e.g. as the key in their `dependencies`).
    .name = .zocket,
    // Semantic version of the package.
    .version = "1.1.0",
    .fingerprint = 0x22ea3973da1c863e, // Changing this has security and trust implications.
    // Earliest Zig version this package supports.
    .minimum_zig_version = "0.18.0-dev",
    .license = "MIT",
    // Each dependency must provide either a `url` and `hash`, or a `path`.
    .dependencies = .{},
    // Files included in the package hash and kept when fetched.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "LICENSE.md",
        "README.md",
        "src",
    },
}
